# Copy this file to .env.local and replace only the values needed by your
# environment. .env.local is ignored by Git. Spring Boot reads exported
# environment variables; see README.md for the safe loading command.

# ---- Local application ----------------------------------------------------
SERVER_PORT=8080
DATABASE_URL=jdbc:sqlite:runtime/gmo-payments.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=on
OPERATOR_API_TOKEN=replace-with-a-random-local-operator-token

# ---- GMO execution gate ---------------------------------------------------
# Keep false until sandbox credentials, browser returns, and callback ingress
# have been tested. A clean public clone always runs the deterministic adapter.
GMO_LIVE_CALLS_ENABLED=false
GMO_OPENAPI_BASE_URL=https://stg.openapi.mul-pay.jp
GMO_PROTOCOL_BASE_URL=https://pt01.mul-pay.jp/payment
GMO_MP_TOKEN_JS_URL=https://stg.static.mul-pay.jp/payment/js/mp-token.js
GMO_OPENAPI_VERSION=
GMO_SHOP_ID=
GMO_SHOP_PASS=
GMO_SITE_ID=
GMO_SITE_PASS=

# ---- Browser returns and webhooks ----------------------------------------
# Use a public HTTPS origin owned by your deployment (Cloudflare Tunnel,
# ngrok, reverse proxy, etc.). Do not commit a personal host name.
DEV_PUBLIC_BASE_URL=https://payments.example.com
GMO_BROWSER_RETURN_BASE_URL=https://payments.example.com
GMO_CUSTOMER_APP_BASE_URL=http://127.0.0.1:4200
GMO_WEBHOOKS_ENABLED=false
GMO_OPENAPI_WEBHOOK_URL=
GMO_PROTOCOL_NOTIFICATION_URL=
GMO_WEBHOOK_INGRESS_TOKEN=
# Independent HMAC secret for GMO's per-order OpenAPI csrfToken. When blank,
# the private GMO shop password is used; set a separate random value in production.
GMO_WEBHOOK_CSRF_SECRET=

# ---- GMO safe-read retry policy ------------------------------------------
# These values apply only to inquiries. Financial writes are never retried
# automatically after an ambiguous response.
GMO_SAFE_READ_MAX_ATTEMPTS=3
GMO_SAFE_READ_INITIAL_DELAY_MS=200
GMO_SAFE_READ_MAX_DELAY_MS=2000

# ---- Independent SFTP reconciliation ------------------------------------
SFTP_RECONCILIATION_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_KNOWN_HOSTS_PATH=
SFTP_INCOMING_PATH=/incoming
SFTP_ARCHIVE_PATH=/archive
SFTP_READY_MARKER_SUFFIX=.ok
SFTP_FILENAME_REGEX=^gmo-reconciliation-[A-Za-z0-9._-]+\.(csv|tsv)$
SFTP_MAX_FILE_BYTES=10485760
SFTP_CONNECT_TIMEOUT_MS=10000
SFTP_POLL_INTERVAL_MS=300000
